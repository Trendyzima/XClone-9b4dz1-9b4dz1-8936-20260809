# .npmrc
#
# node-options uses ${INIT_CWD} — npm sets this to the project root BEFORE any
# script or lifecycle hook runs, so it resolves to an absolute path even when
# postinstall scripts (e.g. @swc/core) execute from a different CWD.
#
# This ensures _preload.cjs runs before Vite loads its ESM chunks in both:
#   • OnSpace live preview  (npm run build / npm run dev)
#   • Vercel npm install    (postinstall scripts — INIT_CWD = /vercel/path0)
#
# Note: _build.cjs (used by Vercel's buildCommand) overrides NODE_OPTIONS with
# its own absolute path, so there is no double-registration on Vercel builds.

node-options=--require ${INIT_CWD}/_preload.cjs
