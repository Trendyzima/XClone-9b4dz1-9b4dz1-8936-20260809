# .npmrc
#
# node-options uses module-name resolution (no './' prefix) so Node traverses
# up the directory tree to find node_modules/_preload-fix/ from ANY working
# directory — including npm postinstall scripts (which run from the package
# directory, not the project root).
#
# _preload-fix/package.json has main: "../../_preload.cjs"
# which resolves to the project-root _preload.cjs via __dirname.
# Absolute-path --require so Node finds _preload.cjs from ANY working directory
# (including npm postinstall scripts for @swc/core, esbuild, etc.).
# The path is stable: OnSpace always builds at /tmp/projects_react_customize/project1/
# Vercel: vercel.json installCommand strips this line via sed before npm install,
#         so postinstall scripts on Vercel are not affected.
node-options=--require /tmp/projects_react_customize/project1/_preload.cjs

# Vercel builds:  vercel.json buildCommand = "node _build.cjs"
#   _build.cjs loads _preload.cjs via __dirname (always absolute) and
#   passes it + vite-fix-loader.mjs to the vite subprocess via NODE_OPTIONS.
#
# OnSpace preview: vite.config.cjs registers vite-fix-loader.mjs via
#   Module.register() with SharedArrayBuffer synchronization, which blocks
#   until the ESM hook is fully active — before require('vite') can
#   trigger any dynamic ESM chunk imports.
#
# Bun builds: covered by bunfig.toml  [run] preload = ["./_preload.cjs"]
