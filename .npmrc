# .npmrc
#
# node-options is intentionally NOT set here.
#
# Vercel builds use `node _build.cjs` (set in vercel.json buildCommand).
# _build.cjs resolves _preload.cjs via __dirname (always absolute) and
# passes it to the vite subprocess via NODE_OPTIONS — no .npmrc needed.
#
# Bun builds are covered by bunfig.toml  [run] preload = ["./_preload.cjs"]
#
# Do NOT add node-options here: npm does NOT expand ${INIT_CWD} in the
# node-options field before passing it to Node, causing npm install to
# fail with "Cannot find module '${INIT_CWD}/_preload.cjs'".
