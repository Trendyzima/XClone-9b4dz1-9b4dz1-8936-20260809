# .npmrc
#
# node-options loads _preload.cjs before Node runs ANY script/command.
# This is critical for the OnSpace preview environment which runs:
#   npm run build  →  vite build  (subprocess)
# npm sets NODE_OPTIONS for the ENTIRE subprocess tree, so the preload
# hook is active before vite loads its first ESM chunk — the only way
# to intercept corruption that happens before vite.config.cjs loads.
#
# Vercel safety: vercel.json sets installCommand = "NODE_OPTIONS= npm install"
# which CLEARS NODE_OPTIONS during the install phase so postinstall
# scripts (e.g. @swc/core, esbuild) never see the --require flag and
# never fail with "Cannot find module './_preload.cjs'".
# Vercel's build phase uses `node _build.cjs` directly — not npm — so
# .npmrc node-options does not apply there at all.
#
# Bun builds are also covered by bunfig.toml  [run] preload = ["./_preload.cjs"]
node-options=--require ./_preload.cjs
