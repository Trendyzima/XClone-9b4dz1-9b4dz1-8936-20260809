{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "testagram-api",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-06",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [
    { "pattern": "testagram.site/api/*", "zone_name": "testagram.site" },
    { "pattern": "www.testagram.site/api/*", "zone_name": "testagram.site" }
  ],
  "vars": {
    "APP_ORIGIN": "https://testagram.site"
  },
  "secrets": {
    "required": ["SUPABASE_URL", "SUPABASE_ANON_KEY"]
  }
}
