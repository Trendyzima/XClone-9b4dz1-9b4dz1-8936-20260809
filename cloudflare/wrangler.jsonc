{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "testagram-api",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-06",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [
    { "pattern": "testagram.site/api/*", "zone_name": "testagram.site" },
    { "pattern": "www.testagram.site/api/*", "zone_name": "testagram.site" }
  ],
  "vars": {
    "APP_ORIGIN": "https://testagram.site",
    "SUPABASE_URL": "https://aepbqfrmheihfsauzcby.supabase.co",
    "SUPABASE_PROJECT_REF": "aepbqfrmheihfsauzcby"
  },
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "testagram-media"
    }
  ],
  "secrets": {
    "required": ["SUPABASE_ANON_KEY"]
  }
}
